# Optional: enable real walkthrough-form delivery via Resend.
# Without these set, /get-started runs in demo mode — submissions log to
# the server console and the user still sees the success state.

# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives walkthrough requests
SAYHII_INBOX_EMAIL=hi@sayhii.io

# Verified sending domain in Resend
SAYHII_FROM_EMAIL=noreply@sayhii.io

# Admin portal — Customer Lookup activation panel (optional).
# Reads monthly-activation numbers (answered vs expected) from the
# activation-service's internal endpoint. Without both set, the panel is hidden.
ACTIVATION_API_URL=
ACTIVATION_INTERNAL_TOKEN=

# Admin portal auth — Google Workspace SSO, restricted to @sayhii.io.
# Without these, the portal opens with a dev identity in local dev only
# (never on a real deploy). Once set, real Google sign-in is enforced.
#   AUTH_SECRET:        openssl rand -base64 33
#   AUTH_GOOGLE_ID/SECRET: a Google Cloud OAuth 2.0 "Web application" client.
#   Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
